# ======================
# Application
# ======================
APP_NAME=Personal Documentation Agent
APP_VERSION=1.0.0
DEBUG=true

# ======================
# API
# ======================
API_HOST=0.0.0.0
API_PORT=8000
API_PREFIX=/api/v1

# ======================
# CORS
# ======================
CORS_ORIGINS=["http://localhost:8501","http://localhost:3000"]

# ======================
# Ollama (Local LLM)
# ======================
OLLAMA_HOST=http://ollama:11434
OLLAMA_MODEL=mistral

# ======================
# ChromaDB
# ======================
CHROMA_HOST=chromadb
CHROMA_PORT=8000
CHROMA_COLLECTION=pda_documents

# ======================
# Data Paths
# ======================
DATA_DIR=/data
DOCUMENTS_DIR=/data/documents
CHATS_DIR=/data/chats
KIRO_DIR=/data/kiro
INVOICES_DIR=/data/invoices
VECTORDB_DIR=/data/vectordb

# ======================
# Parser Settings
# ======================
CHUNK_SIZE=1000
CHUNK_OVERLAP=200

# ======================
# Upload Settings
# ======================
MAX_UPLOAD_SIZE_MB=50